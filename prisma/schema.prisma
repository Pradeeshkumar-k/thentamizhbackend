generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  username        String?           @unique
  name            String?
  passwordHash    String
  role            Role              @default(USER)
  createdAt       DateTime          @default(now())

  bookmarks       Bookmark[]
  comments        Comment[]
  likes           Like[]
  novels          Novel[]
  novelLikes      NovelLike[]
  readingProgress ReadingProgress[]
}

/* ===================== NOVEL ===================== */

model Novel {
  id                String            @id @default(uuid())
  title             String
  description       String
  genre             String
  status            NovelStatus       @default(DRAFT)
  deletedAt         DateTime?
  titleEn           String?
  descriptionEn     String?
  views             Int               @default(0)
  coverImageUrl     String?
  authorId          String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  author            User              @relation(fields: [authorId], references: [id])
  chapters          Chapter[]
  bookmarks         Bookmark[]
  likes             NovelLike[]
  readingProgresses ReadingProgress[]

  @@index([authorId])
  @@index([createdAt])
  @@index([status, deletedAt, createdAt])
}

/* ===================== CHAPTER ===================== */

model Chapter {
  id            String        @id @default(uuid())
  novelId       String
  title         String
  content       String
  titleEn       String?
  contentEn     String?
  thumbnailUrl  String?
  views         Int           @default(0)
  order         Int           // RESTORED: 'chapterOrder' -> 'order' to match controller code
  isTranslating Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  novel             Novel        @relation(fields: [novelId], references: [id], onDelete: Cascade)
  comments          Comment[]
  likes             Like[]
  readingProgresses ReadingProgress[]
  views_list        ChapterView[] // RESTORED: 'viewsList' -> 'views_list' to match existing schema style

  @@index([novelId, order])
}

/* ===================== COMMENT ===================== */

model Comment {
  id        String   @id @default(uuid())
  text      String
  chapterId String
  userId    String
  createdAt DateTime @default(now())

  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chapterId, createdAt])
}

/* ===================== LIKE ===================== */

model Like {
  chapterId String
  userId    String

  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chapterId, userId])
  @@index([userId])
}

/* ===================== BOOKMARK ===================== */

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  novelId   String
  createdAt DateTime @default(now())

  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, novelId])
  @@index([novelId])
}

/* ===================== NOVEL LIKE ===================== */

model NovelLike {
  id        String   @id @default(uuid())
  userId    String
  novelId   String
  createdAt DateTime @default(now())

  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, novelId])
  @@index([novelId])
}

/* ===================== READING PROGRESS ===================== */

model ReadingProgress {
  id        String   @id @default(uuid())
  userId    String
  novelId   String
  chapterId String
  progress  Int      @default(0)
  lastRead  DateTime @default(now())

  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
}

/* ===================== CHAPTER VIEW ===================== */

model ChapterView {
  id        String   @id @default(uuid())
  chapterId String
  ip        String
  userId    String?
  viewedAt  DateTime @default(now())

  chapter   Chapter  @relation(fields: [chapterId], references: [id])

  @@index([chapterId, ip])
  @@index([chapterId, userId])
}

/* ===================== ENUMS ===================== */

enum Role {
  USER
  ADMIN
}

enum NovelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  COMPLETED
  DELETED
}

/* ===================== ACTIVITY LOG ===================== */

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  timestamp DateTime @default(now())
}
