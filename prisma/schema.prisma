generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  username        String?           @unique
  name            String?
  passwordHash    String
  role            Role              @default(USER)
  createdAt       DateTime          @default(now())
  bookmarks       Bookmark[]
  comments        Comment[]
  likes           Like[]
  novels          Novel[]
  novelLikes      NovelLike[]
  readingProgress ReadingProgress[]
}

model Novel {
  id                String            @id @default(uuid())
  title             String
  description       String
  genre             String
  status            NovelStatus       @default(DRAFT)
  deletedAt         DateTime?
  titleEn           String?
  descriptionEn     String?
  views             Int               @default(0)
  coverImageUrl     String?
  authorId          String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bookmarks         Bookmark[]
  chapters          Chapter[]
  author            User              @relation(fields: [authorId], references: [id])
  likes             NovelLike[]
  readingProgresses ReadingProgress[]

  @@index([createdAt])
  @@index([status])
  @@index([authorId])
  @@index([status, deletedAt, createdAt])
}

model Chapter {
  id                String            @id @default(uuid())
  novelId           String
  title             String
  content           String
  titleEn           String?
  contentEn         String?
  thumbnailUrl      String?
  views             Int               @default(0)
  order             Int
  isTranslating     Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  novel             Novel             @relation(fields: [novelId], references: [id], onDelete: Cascade)
  comments          Comment[]
  likes             Like[]
  readingProgresses ReadingProgress[]
  views_list        ChapterView[]

  @@index([novelId, order])
  @@index([novelId]) // Added explicit index
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  novelId   String
  createdAt DateTime @default(now())
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, novelId])
}

model NovelLike {
  id        String   @id @default(uuid())
  userId    String
  novelId   String
  createdAt DateTime @default(now())
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, novelId])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  chapterId String
  userId    String
  createdAt DateTime @default(now())
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chapterId]) // Added explicit index
}

model Like {
  chapterId String
  userId    String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chapterId, userId])
  @@index([chapterId]) // Added explicit index
  @@index([userId])    // Added explicit index
}

model ReadingProgress {
  id        String   @id @default(uuid())
  userId    String
  novelId   String
  chapterId String
  progress  Int      @default(0)
  lastRead  DateTime @default(now())
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@index([userId, novelId]) // Added composite index
}

model ChapterView {
  id        String   @id @default(uuid())
  chapterId String
  ip        String
  userId    String?
  viewedAt  DateTime @default(now())

  chapter   Chapter  @relation(fields: [chapterId], references: [id])

  @@index([chapterId, ip])
  @@index([chapterId, userId])
}

enum Role {
  USER
  ADMIN
}

enum NovelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  COMPLETED
  DELETED
}
